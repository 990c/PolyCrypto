# Operation mode: DATA_COLLECTION | PAPER | LIVE
OPERATION_MODE=DATA_COLLECTION

# Model and data paths
MODEL_PATH=catboost_model.cbm
DATASET_PATH=dataset.csv

# Model version: v1 (per-tick) | v2 (epoch-aligned; use with MODEL_PATH=catboost_model_v2.cbm)
# MODEL_VERSION=v1

# Conviction gate: skip trades when P(UP) is within this distance of 0.5
# MIN_MODEL_CONFIDENCE=0.08

# Hard spend caps enforced by the executor (LIVE mode)
# MAX_SINGLE_TRADE_USD=50
# MAX_DAILY_SPEND_USD=200

# Starting bankroll (used by risk manager, paper engine, trade logger)
# STARTING_BANKROLL=1000.0

# Prediction frequency override (defaults: 100ms for collection, 2000ms for trading)
# PREDICTION_FREQUENCY_MS=2000

# Binance WebSocket URL override (default: Binance Futures)
# For Binance US: wss://stream.binance.us:9443/stream?streams=btcusdt@depth20@100ms/btcusdt@trade
# BINANCE_WS_URL=wss://fstream.binance.com/stream?streams=btcusdt@depth20@100ms/btcusdt@trade

# Polymarket CLOB credentials
# POLY_PRIVATE_KEY: Your Ethereum/Polygon wallet private key (0x...)
#   -> MetaMask: Account Details > Show Private Key
#   -> Phantom: Settings > Security > Export Private Key (select Ethereum account)
POLY_PRIVATE_KEY=0xREPLACE_WITH_YOUR_PRIVATE_KEY

# POLY_FUNDER: Your public wallet address (0x...)
#   -> Copy from your wallet or Polymarket profile page
POLY_FUNDER=0xREPLACE_WITH_YOUR_WALLET_ADDRESS

# Wallet type: 0 = EOA, 1 = Polymarket proxy (email/embedded wallet), 2 = Gnosis Safe
# POLY_SIGNATURE_TYPE=1

# Polymarket host and chain (defaults are correct, no change needed)
# POLY_HOST=https://clob.polymarket.com
# POLY_CHAIN_ID=137
